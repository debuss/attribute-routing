{
  "name": "debuss-a/attribute-routing",
  "description": "Framework-agnostic route loader that discovers routes from PHP attributes and returns router-ready RouteDefinition objects.",
  "license": "MIT",
  "authors": [
    {
      "name": "Alexandre Debusschère",
      "email": "alexandre.debusschere@hey.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Routing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Routing\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-phpunit": "^2.0"
  },
  "scripts": {
    "analyse": "phpstan analyse",
    "test": "phpunit"
  }
}
